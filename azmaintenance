#!/bin/bash
#
# Enable or Disable the maintenance mode on Azure servers and monitored web URLs
# https://github.com/luisbunuel/aztools

VERSION="1.2"
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'
rule="RemoveAllActionGroups"
me=`basename "$0"`
start_date=`date -u +"%Y-%m-%d %H:%M:%S"`
temp_finish_date=`date -u -d "+1 hour" +"%Y-%m-%d %H:%M:%S"`

help() {
	echo
	echo "Syntax:"
	echo
	echo "    $me -o organization -e environment -a action [-s start_date] [-f finish_date] [-d description]"
	echo "    $me -w url [-w url ...] -a action [-s start_date] [-f finish_date] [-d description]"
	echo
	echo "Options:"
	echo
	echo "    -o   Enter the organizatino IIIM|IIMM"
	echo
	echo "    -e   Enter the environment prod|test"
	echo
	echo "    -w   Enter a web URL monitored by an App Insights web test (UNICC CWHM, UN Women or UNDP)"
	echo "           Can be repeated. -o and -e are not needed with -w"
	echo "           The web maintenance rule is created on enable if it does not exist"
	echo
	echo "    -a   Enter the action enable|disable"
	echo
	echo -e "    -s   Enter the start date of the maintenance \033[33;5mUSE UTC!\033[0m"
	echo "           Format: \"yyyy-mm-dd hh:mm:ss\""
	echo "           Default: Current date"
	echo
	echo -e "    -f   Enter the finish date of the maintenance \033[33;5mUSE UTC!\033[0m"
	echo "           Format: \"yyyy-mm-dd hh:mm:ss\""
	echo "           Default: Start date + 1 hour"
	echo
	echo "    -d   Enter a description of the maintenance"
	echo "           Default: empty" 
	echo
	echo "Examples:"
	echo 
	echo "	$me -o IIIM -e prod -a enable -s \"$start_date\" -f \"$temp_finish_date\" -d \"Monthly patching\" "
	echo "	$me -o IIMM -e test -a disable"
	echo "	$me -w https://bangkok.ohchr.org -w cambodia.ohchr.org -a enable -f \"$temp_finish_date\" -d \"Until PHP is patched\" "
	echo "	$me -w bangkok.ohchr.org -a disable"
	echo
}

# Web URLs are monitored by App Insights web tests. A web test is put in maintenance by the
# "<test> - Web Maintenance Mode" processing rule of its resource group. In Cloud Web Hosting
# Monitoring Terraform creates one per test; elsewhere (UN Women) most tests have none.
# An existing rule is updated in place (--set) to keep its Terraform tags; a missing one is
# created on enable, with the same conditions Terraform uses.
# Subscriptions with web tests, as profile:tenant:subscription (profile = ~/.azure_<profile>)
web_targets=(
	"UNICC:unicc.onmicrosoft.com:1c4f31f8-0ebe-4167-b641-e30e9796ed88"
	"WOMEN:2bcd0744-9e18-487d-85c3-c9a325220be8:9c358701-163d-446b-ae40-41537f2e58f4"
	"UNDP:8a28c155-4f07-42b5-ae59-e480499031dd:e9d86b44-b795-49db-a164-52dd079ea32e"
	"UNDP:8a28c155-4f07-42b5-ae59-e480499031dd:d814ebea-702d-465a-a3db-f1235970409e"
)

web_maintenance() {
	case $action in
		enable|disable) ;;
		*)
			echo "Enter a valid action: enable or disable"
			exit 1
			;;
	esac

	for target in "${web_targets[@]}"
	do
		IFS=: read -r profile tenant subscription <<< "$target"
		export AZURE_CONFIG_DIR=~/.azure_$profile
		if ! az account get-access-token &>/dev/null; then
			az login --tenant $tenant &>/dev/null
		fi
	done

	# Each entry: profile|subscription|resource_group|test|rule (rule empty if missing)
	rules=()
	for web in "${webs[@]}"
	do
		host=${web#*://}
		host=${host%%/*}
		if [[ ! $host =~ ^[A-Za-z0-9.-]+$ ]]; then
			echo -e "$web: ${RED}Invalid URL${NC}"
			continue
		fi

		found=""
		for target in "${web_targets[@]}"
		do
			IFS=: read -r profile tenant subscription <<< "$target"
			query="resources
| where type =~ 'microsoft.insights/webtests'
| where tostring(split(tostring(split(tostring(properties.Request.RequestUrl), '://')[1]), '/')[0]) =~ '$host'
| project test=tostring(properties.Name), resourceGroup=tolower(resourceGroup)
| join kind=leftouter (resources
    | where type =~ 'microsoft.alertsmanagement/actionrules' and name endswith ' - Web Maintenance Mode'
    | project rule=name, test=replace_string(name, ' - Web Maintenance Mode', ''), resourceGroup=tolower(resourceGroup)) on test, resourceGroup
| project line=strcat('$profile|$subscription|', resourceGroup, '|', test, '|', rule)"

			lines=`AZURE_CONFIG_DIR=~/.azure_$profile az graph query --subscriptions $subscription -q "$query" --query 'data[].line' -o tsv 2>/dev/null`
			if [ $? != 0 ]; then
				echo -e "$web: ${RED}Query error in $profile${NC}"
				continue
			fi
			[ -n "$lines" ] && found+="$lines"$'\n'
		done

		if [ -z "$found" ]; then
			echo -e "$web: ${RED}No web test found${NC}"
			continue
		fi
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			IFS='|' read -r profile subscription rg test rule <<< "$line"
			if [ -z "$rule" ] && [ "$action" == "disable" ]; then
				echo "$web: \"$test\" has no maintenance rule, nothing to disable"
				continue
			fi
			rules+=("$line")
		done <<< "$found"
	done

	if [ ${#rules[@]} -eq 0 ]; then
		exit 1
	fi

	echo
	if [ "$action" == "enable" ]; then
		echo "Enabling web maintenance"
		echo
		echo "	Start date: $start_date" UTC;
		echo "	Finish date: $finish_date" UTC;
		echo "	Description: $description";
	else
		echo "Disabling web maintenance"
	fi
	echo
	for r in "${rules[@]}"; do
		IFS='|' read -r profile subscription rg test rule <<< "$r"
		if [ -n "$rule" ]; then
			echo "	$rule ($profile)"
		else
			echo "	$test - Web Maintenance Mode ($profile, will be created)"
		fi
	done
	echo
	echo "You have 10 seconds to cancel this operation ..."

	secs=10
	while [ $secs -gt 0 ]; do
		echo -ne "$secs\033[0K\r"
		sleep 1
		: $((secs--))
	done

	echo
	echo

	for r in "${rules[@]}"
	do
		IFS='|' read -r profile subscription rg test rule <<< "$r"
		export AZURE_CONFIG_DIR=~/.azure_$profile
		if [ "$action" == "disable" ]; then
			az monitor alert-processing-rule update --subscription $subscription --resource-group $rg --name "$rule" --enabled false &>/dev/null
		elif [ -n "$rule" ]; then
			az monitor alert-processing-rule update --subscription $subscription --resource-group $rg --name "$rule" --enabled true --set properties.description="$description" "properties.schedule={\"effectiveFrom\":\"${start_date/ /T}\",\"effectiveUntil\":\"${finish_date/ /T}\",\"timeZone\":\"UTC\"}" &>/dev/null
		else
			# create stores --description as "['text']", so it is set afterwards
			rule="$test - Web Maintenance Mode"
			az monitor alert-processing-rule create --subscription $subscription --resource-group $rg --name "$rule" --scopes "/subscriptions/$subscription/resourceGroups/$rg" --rule-type RemoveAllActionGroups --filter-monitor-condition Equals Fired --filter-alert-context Contains "$test" --enabled true --schedule-start-datetime "$start_date" --schedule-end-datetime "$finish_date" --schedule-time-zone UTC &>/dev/null &&
			az monitor alert-processing-rule update --subscription $subscription --resource-group $rg --name "$rule" --set properties.description="$description" &>/dev/null
		fi

		if [ $? == 0 ]; then
			echo -e "$rule: ${GREEN}Success${NC}"
		else
			echo -e "$rule: ${RED}Error${NC}"
		fi
	done
}

if [ $# -eq 0 ]; then
	help
	exit 1
fi

webs=()

while getopts o:e:a:s:f:d:w: flag
do
    case "${flag}" in
		o) organization=${OPTARG};;
	    e) environment=${OPTARG};;
		a) action=${OPTARG};;
        s) start_date=${OPTARG};;
        f) finish_date=${OPTARG};;
        d) description=${OPTARG};;
		w) webs+=("${OPTARG}");;
    esac
done

if [ -z "$organization" ] && [ ${#webs[@]} -eq 0 ]; then
	echo
	echo "Please enter the organization, -o [IIIM|IIMM]"
	exit 1
fi

if [ -z "$environment" ] && [ ${#webs[@]} -eq 0 ]; then
	echo
	echo "The environment can't be empty, enter -e [prod|test]"
	exit 1
fi

if [ -z "$action" ]; then
	echo
	echo "Specify the action to take, enter -a [enable|disable]"
	exit 1
fi

if [ -z "$finish_date" ]; then
	finish_date=`date -d "$start_date +hour" +"%Y-%m-%d %H:%M:%S"`
fi

if [ ${#webs[@]} -gt 0 ]; then
	web_maintenance
	exit 0
fi

case $organization in
	IIIM)
		export AZURE_CONFIG_DIR=~/.azure_IIIM
		az config set extension.use_dynamic_install=yes_without_prompt &>/dev/null
		resource_group="RG-IIIM-cloudops"
		scope="/subscriptions/5638ba20-5e01-4f95-ac49-a4c1f1f2af66/resourceGroups/RG-IIIM-cloudops"
		org="iiim"
		;;
	IIMM)
		export AZURE_CONFIG_DIR=~/.azure_IIMM
		az config set extension.use_dynamic_install=yes_without_prompt &>/dev/null
		resource_group="RG-IIMM-cloudops"
		scope="/subscriptions/17e000ff-d917-43d8-9d1a-eaf799757636/resourceGroups/RG-IIMM-cloudops"
		org="iimm"
		;;
	*)
		echo
		echo "Enter a valid organization: IIIM or IIMM"
		exit 1
		;;
esac

case $environment in
	prod)
		env="p"
		servers=($org-dw-$env-appsrv-01 $org-dw-$env-appsrv-02 $org-dw-$env-compsrv-01 $org-dw-$env-compsrv-02 $org-dw-$env-compsrv-03 $org-dw-$env-intsrv-01 $org-dw-$env-intsrv-02 $org-dw-$env-haproxy) 
		servers=("${servers[@]}" $org-dw-p-monsrv-01)
		;;
	test)
		env="t"
		servers=($org-dw-$env-appsrv-01 $org-dw-$env-appsrv-02 $org-dw-$env-compsrv-01 $org-dw-$env-compsrv-02 $org-dw-$env-compsrv-03 $org-dw-$env-intsrv-01 $org-dw-$env-intsrv-02 $org-dw-$env-haproxy)
		;;
	*)
		echo 
		echo "Enter a valid environment name: prod or test"
		exit 1
		;;
esac

case $action in
	enable)
		if ! az account get-access-token &>/dev/null; then
			az login &>/dev/null
		fi

		az account set -s "$organization - Shared Management"

		echo
		echo "Enabling $organization servers maintenance"
		echo
		echo "	Environment: $environment";
		echo "	Start date: $start_date" UTC;
		echo "	Finish date: $finish_date" UTC;
		echo "	Description: $description";
		echo
		echo "You have 10 seconds to cancel this operation ..."

		secs=10
		while [ $secs -gt 0 ]; do
			echo -ne "$secs\033[0K\r"
			sleep 1
			: $((secs--))
		done

		echo
		echo 

		for server in ${servers[@]}
		do
			# create stores --description as "['text']", so it is set afterwards
			az monitor alert-processing-rule create --enabled true --name "$server - Server Maintenance Mode" --resource-group $resource_group --scope $scope --filter-alert-context Contains $server --filter-monitor-condition Equals Fired --rule-type $rule --schedule-start-datetime "$start_date" --schedule-end-datetime "$finish_date" &>/dev/null &&
			az monitor alert-processing-rule update --name "$server - Server Maintenance Mode" --resource-group $resource_group --set properties.description="$description" &>/dev/null
			if [ $? == 0 ]; then
				echo -e "$server: ${GREEN}Success${NC}"
			else
				echo -e "$server: ${RED}Error${NC}"
			fi
		done
		;;

	disable)
		if ! az account get-access-token &>/dev/null ; then
    		az login &>/dev/null
		fi

		az account set -s "$organization - Shared Management"
		
		echo
        echo "Disabling $organization servers maintenance ..."
        echo
        echo "You have 10 seconds to cancel this operation ..."

        secs=10
        while [ $secs -gt 0 ]; do
            echo -ne "$secs\033[0K\r"
            sleep 1
            : $((secs--))
        done

        echo
        echo

        for server in ${servers[@]}
        do
			az monitor alert-processing-rule update --resource-group "RG-$organization-cloudops" --name "$server - Server Maintenance Mode" --enabled false &>/dev/null

            if [ $? == 0 ]; then
                echo -e "$server: ${GREEN}Success${NC}"
            else
                echo -e "$server: ${RED}Error${NC}"
            fi

        done
		;;

	*)
		echo
        echo "Enter a valid action: enable or disable"
        exit 1
        ;;
esac
