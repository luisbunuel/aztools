#!/bin/bash
#
# Open a tunnel with a server through Azure Bastion
# https://github.com/luisbunuel/aztools
# Refactored to use fzf instead of dialog

VERSION="2.0 (fzf)"
azuser="admbunuel"

if [ -z "$azuser" ]; then
	echo "Error: The 'azuser' variable is not set. Please edit this script and set it."
	exit 1 
fi

# ==============================================================================
# CONFIGURATION DEFINITION
# ==============================================================================

# Tenant Definitions
IIIM_tenant="iiimprod.onmicrosoft.com"
IIIM_config_dir="$HOME/.azure_IIIM"
UNDP_tenant="iccundp.onmicrosoft.com"
UNDP_config_dir="$HOME/.azure_UNDP"
UNWOMEN_tenant="unwomen.onmicrosoft.com"
UNWOMEN_config_dir="$HOME/.azure_WOMEN"
UNDPBIO_tenant="iccundp.onmicrosoft.com"
UNDPBIO_config_dir="$HOME/.azure_UNDPBIO"
UNCTAD_tenant="unicc.onmicrosoft.com"  # for UNCTAD we use the UNICC bastion
UNCTAD_config_dir="$HOME/.azure_UNICC"

# Map of Tenant Names to their Configurations and Subscriptions
declare -A TENANT_MAP=(
    ["IIIM"]="$IIIM_config_dir:$IIIM_tenant:IIIM - Connectivity Hub"
    ["UNDP"]="$UNDP_config_dir:$UNDP_tenant:ICCUNDP - Production"
    ["UNWOMEN"]="$UNWOMEN_config_dir:$UNWOMEN_tenant:UNICC"
    ["UNDPBIO"]="$UNDPBIO_config_dir:$UNDPBIO_tenant:UNDP - UN Biodiversity Lab Hosting - WP site"
    ["UNCTAD"]="$UNCTAD_config_dir:$UNCTAD_tenant:UNICC OPDA - Shared Bastion"
)

# Server/Bastion Definitions (Tenant:Environment:Bastion:RG:Servers)
# Servers format: "SERVER_NAME:IP_ADDRESS|SERVER_NAME:IP_ADDRESS..."
declare -A AZURE_RESOURCES=(
    # IIIM
    ["IIIM:Production"]="iiim-conn-dw-bastion:RG-IIIM-ConnHub-Datawalk:iiim-dw-p-appsrv-01:10.88.62.4|iiim-dw-p-appsrv-02:10.88.62.5|iiim-dw-p-intsrv-01:10.88.62.36|iiim-dw-p-intsrv-02:10.88.62.37|iiim-dw-p-compsrv-01:10.88.62.68|iiim-dw-p-compsrv-02:10.88.62.69|iiim-dw-p-compsrv-03:10.88.62.70|iiim-dw-p-monsrv-01:10.88.62.38|iiim-dw-p-haproxy:10.88.62.10"
    ["IIIM:Test"]="iiim-conn-dw-bastion:RG-IIIM-ConnHub-Datawalk:iiim-dw-t-appsrv-01:10.88.61.4|iiim-dw-t-appsrv-02:10.88.61.5|iiim-dw-t-intsrv-01:10.88.61.36|iiim-dw-t-intsrv-02:10.88.61.37|iiim-dw-t-compsrv-01:10.88.61.68|iiim-dw-t-compsrv-02:10.88.61.69|iiim-dw-t-compsrv-03:10.88.61.70|iiim-dw-t-haproxy:10.88.61.10"

    # UNDP
    ["UNDP:Production"]="UNDP-PRD-AZRWEU-BASTION-VNET-01:UNDP-PRD-AZRWEU-HUB:DPLPRODCF02:10.88.1.46|DPSPRODCF02:10.88.1.47"
    ["UNDP:Test"]="UNDP-PRD-AZRWEU-BASTION-VNET-01:UNDP-PRD-AZRWEU-HUB:DPLNONPRODCF02:10.88.1.42"

    # UNWOMEN
    ["UNWOMEN:Production"]="UNWOMEN-EAST-US-bastion:UNWOMEN-EAST-US-Migrated:UNWMEUSELPRDWEB01 - TRAINING CENTRE:10.88.135.164|UNWMEUSELPRDWEB02 - NEW TRAINING CENTRE:10.88.135.165|UNWMEUSLMSP01 - WEPS:10.0.0.4"
    ["UNWOMEN:Test"]="UNWOMEN-EAST-US-bastion:UNWOMEN-EAST-US-Migrated:UNWMEUSELDEVWEB01 - TRAINING CENTRE:10.88.135.148|UNWMEUSLMSD01 - WEPS:10.0.1.4"

    # UNDPBIO
    ["UNDPBIO:Production"]="undp-biolab-bastion:undp-prd-biolab-website:undpbio:10.88.2.68"

    # UNCTAD
    ["UNCTAD:Production"]="opda-shared-bastion:RG-opda-shared-bastion:dmzprodunctadorg-web1:10.0.1.4|dmzprodunctadorg-web2:10.0.1.7|dmzprodunctadorg-solr1:10.0.1.5"
    ["UNCTAD:Test"]="opda-shared-bastion:RG-opda-shared-bastion:dmzuatunctadorg-web1:10.0.0.4"
)

# ==============================================================================
# FUNCTIONS
# ==============================================================================

check_ssh() {
	# Check and install the Azure CLI SSH extension if missing
	if ! az extension show -n ssh &>/dev/null; then
		echo "Installing Azure SSH extension..."
		az extension add -n ssh &>/dev/null
	fi
}

check_fzf() {
	# Verify fzf is installed before relying on it for every menu
	if ! command -v fzf &>/dev/null; then
		echo "Error: 'fzf' is not installed. Install it (e.g. 'sudo apt install fzf') and try again."
		exit 1
	fi
}

generate_tenant_fzf_list() {
    for tenant_name in "${!TENANT_MAP[@]}"; do
        IFS=':' read -r config_dir tenant_id subscription <<< "${TENANT_MAP[$tenant_name]}"

        AZURE_CONFIG_DIR="$config_dir" az account get-access-token &>/dev/null
        if [ $? -eq 0 ]; then
            echo -e "\e[32m✔ $tenant_name\e[0m"
        else
            echo -e "\e[31m✖ $tenant_name\e[0m"
        fi
    done
}

# ==============================================================================
# MAIN SCRIPT EXECUTION
# ==============================================================================

echo "AZBASTION v.$VERSION"
echo "--------------------------"

check_fzf

# 1. Select Tenant using FZF
selected_line=$(generate_tenant_fzf_list | fzf --ansi --header "Select Tenant (Green = Logged In):" --prompt="Tenant > ")

if [ -z "$selected_line" ]; then
    echo "Tenant selection cancelled."
    exit 0
fi

# Extract the tenant name from the selected line (e.g., "✔      IIIM")
tenant_name_raw=$(echo "$selected_line" | awk '{print $NF}')

if [ -z "${TENANT_MAP[$tenant_name_raw]+x}" ]; then
    echo "Error: unknown tenant '$tenant_name_raw'."
    exit 1
fi

# Retrieve configuration
IFS=':' read -r AZURE_CONFIG_DIR TENANT_ID SUBSCRIPTION <<< "${TENANT_MAP[$tenant_name_raw]}"

# Configure Azure CLI
export AZURE_CONFIG_DIR
az config set extension.use_dynamic_install=yes_without_prompt &>/dev/null

# Login if necessary
if ! az account get-access-token &>/dev/null; then
    echo "--- Logging into $tenant_name_raw ($TENANT_ID) ---"
    az login --tenant "$TENANT_ID" &>> /tmp/azbastion_$USER.log
fi

# Set Subscription
az account set --subscription "$SUBSCRIPTION"
echo "Subscription set to: $SUBSCRIPTION"

# Check SSH extension
check_ssh

# 2. Select Environment using FZF
echo "--------------------------"
environment_list=$(
    for key in "${!AZURE_RESOURCES[@]}"; do
        if [[ "$key" == "$tenant_name_raw":* ]]; then
            echo "$key" | cut -d: -f2
        fi
    done | sort -u
)

selected_environment=$(echo "$environment_list" | fzf --prompt="[$tenant_name_raw] Select Environment: ")

if [ -z "$selected_environment" ]; then
    echo "Environment selection cancelled."
    exit 0
fi

# 3. Select Server using FZF
resource_key="$tenant_name_raw:$selected_environment"

if [ -z "${AZURE_RESOURCES[$resource_key]+x}" ]; then
    echo "Error: unknown environment '$selected_environment' for tenant '$tenant_name_raw'."
    exit 1
fi

resource_data="${AZURE_RESOURCES[$resource_key]}"

# Extract Bastion, RG, and raw servers list
IFS=':' read -r bastion rg raw_servers <<< "$resource_data"

# Convert pipe-separated server list to newline-separated for FZF
server_ip_list=$(printf '%s\n' "$raw_servers" | tr '|' '\n')

# Use awk to format output for FZF (Server Name | IP Address) and then select the line
selected_server_line=$(printf '%s\n' "$server_ip_list" | awk -F':' '{printf "%-40s %s\n", $1, $2}' | fzf --prompt="[$tenant_name_raw/$selected_environment] Select Server (Name | IP): ")

if [ -z "$selected_server_line" ]; then
    echo "Server selection cancelled."
    exit 0
fi

# Extract IP address from the selected line
# The line is now space-padded: "ServerName                     10.x.x.x"
# We extract the last field (the IP)
TARGET_IP=$(echo "$selected_server_line" | awk '{print $NF}')
SERVER_NAME=$(echo "$selected_server_line" | awk '{$NF=""; print $0}' | xargs) # Get all but the last field (IP) and trim

# 4. Initiate Azure Bastion SSH Connection
echo -e "\n--- Connecting to $SERVER_NAME ($TARGET_IP) ---"
echo "Bastion: $bastion, Resource Group: $rg, User: $azuser"

az network bastion ssh -n "$bastion" -g "$rg" --target-ip-address "$TARGET_IP" --auth-type password --username "$azuser"
